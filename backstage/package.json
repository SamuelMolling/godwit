{
  "name": "backstage-plugin-godwit",
  "version": "0.0.1",
  "description": "Read-only view of godwit targets, runs and drift for Backstage",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/SamuelMolling/godwit",
    "directory": "backstage"
  },
  "homepage": "https://github.com/SamuelMolling/godwit/blob/main/docs/use/backstage.md",
  "keywords": [
    "backstage",
    "backstage-plugin",
    "godwit",
    "postgresql",
    "migrations"
  ],
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "godwit",
    "pluginPackages": [
      "backstage-plugin-godwit"
    ]
  },
  "sideEffects": false,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.esm.js",
    "types": "dist/index.d.ts"
  },
  "files": [
    "dist",
    "config.d.ts"
  ],
  "configSchema": "config.d.ts",
  "scripts": {
    "build": "tsc && backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test --watchAll=false --coverage",
    "tsc": "tsc",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@backstage/catalog-model": "^1.7.3",
    "@backstage/core-components": "^0.17.1",
    "@backstage/core-plugin-api": "^1.10.6",
    "@backstage/plugin-catalog-react": "^1.17.0",
    "@material-ui/core": "^4.12.2",
    "react-use": "^17.2.4"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.0 || ^18.0.0",
    "react-router-dom": "^6.3.0"
  },
  "devDependencies": {
    "@backstage/cli": "^0.32.0",
    "@backstage/test-utils": "^1.7.7",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.3.0",
    "typescript": "~5.8.0"
  },
  "jest": {
    "collectCoverageFrom": [
      "**/*.{ts,tsx}",
      "!setupTests.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    }
  },
  "overrides": {
    "@backstage/catalog-client": "1.9.1",
    "@backstage/cli-common": "0.1.15",
    "@backstage/cli-node": "0.2.13",
    "@backstage/config": "1.3.2",
    "@backstage/config-loader": "1.10.0",
    "@backstage/core-app-api": "1.16.1",
    "@backstage/core-compat-api": "0.4.1",
    "@backstage/errors": "1.2.7",
    "@backstage/eslint-plugin": "0.1.10",
    "@backstage/frontend-app-api": "0.11.1",
    "@backstage/frontend-defaults": "0.2.1",
    "@backstage/frontend-plugin-api": "0.10.1",
    "@backstage/frontend-test-utils": "0.3.1",
    "@backstage/integration": "1.16.3",
    "@backstage/integration-react": "1.2.6",
    "@backstage/plugin-app": "0.1.8",
    "@backstage/plugin-catalog-common": "1.1.3",
    "@backstage/plugin-permission-common": "0.8.4",
    "@backstage/plugin-permission-react": "0.4.33",
    "@backstage/plugin-search-common": "1.2.17",
    "@backstage/theme": "0.6.5",
    "@backstage/types": "1.2.1",
    "@backstage/version-bridge": "1.0.11"
  }
}
