PGPASSWORD=change-me-store
GODWIT_SCRATCH_DSN=postgres://godwit_scratch:change-me@scratch.internal:5432/postgres?sslmode=verify-full
GODWIT_MASTER_KEY=change-me-64-hex-characters
GODWIT_TOKENS=ci:pipeline:change-me,ops:operator:change-me,register:admin:change-me
# GODWIT_HOLDER=godwit-a   # per machine: the name in cp_leases.holder and every log line; unset takes the hostname
GODWIT_LOG_FORMAT=json
GODWIT_LOG_LEVEL=info
GODWIT_PUBLIC_URL=https://godwit.example.com
